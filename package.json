{
  "name": "settlr",
  "version": "1.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --webpack",
    "start": "node server.js",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "production-deploy": "npm run postinstall && prisma migrate deploy && npm run build",
    "production-build": "npm run postinstall && npm run build",
    "analyze": "cross-env ANALYZE=true next build --webpack",
    "db:deploy": "prisma migrate deploy && prisma generate",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "auth:generate": "npx @better-auth/cli@latest generate --config ./lib/auth/auth.ts --yes",
    "typecheck": "eslint && tsc --noEmit",
    "reset-password": "tsx scripts/reset-password.ts",
    "sync-template": "git fetch upstream && git merge upstream/main",
    "update": "tsx scripts/auto-update.ts",
    "update:check": "tsx scripts/auto-update.ts --check",
    "update:apply": "tsx scripts/auto-update.ts --apply"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@better-auth/passkey": "^1.7.12",
    "@better-auth/prisma-adapter": "^1.7.12",
    "@ducanh2912/next-pwa": "^10.2.9",
    "@hookform/resolvers": "^5.9.2",
    "@marsidev/react-turnstile": "^1.6.3",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-query-devtools": "^5.104.5",
    "@types/pg": "^8.23.1",
    "better-auth": "^1.7.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "dotenv": "^18.0.9",
    "framer-motion": "^14.6.0",
    "lucide-react": "^1.61.0",
    "next": "^16.4.2",
    "next-themes": "^0.4.6",
    "nextjs-toploader": "^3.9.17",
    "nodemailer": "^10.2.1",
    "prisma": "^7.10.1",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "react-qr-code": "^2.2.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@next/bundle-analyzer": "^16.4.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.2",
    "jimp": "^1.6.1",
    "pg": "^8.23.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true,
    "esbuild@0.28.2": true,
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true,
    "core-js@3.51.0": true
  }
}
