# ============================================================
# AUTH TEMPLATEA - ENVIRONMENT CONFIGURATION
# ============================================================
# Copy this file to .env or .env.local and configure the values.
#
# Required: Must be configured for the related feature to work.
# Optional: Only required when enabling the related feature.
#
# IMPORTANT:
# - Never commit actual secrets or production credentials.
# - Keep server-side secrets private (never use NEXT_PUBLIC_).
# - Restart the application after changing environment variables.


# ============================================================
# 1. APPLICATION ENVIRONMENT
# ============================================================

# Application execution environment
# Options: development | production | test
NODE_ENV=development


# ============================================================
# 2. SECURITY & INITIAL SETUP
# ============================================================

# Enable advanced password breach checking using Have I Been Pwned.
# Options: true | false
# API documentation: https://haveibeenpwned.com/API/v3#Authentication
ADVANCE_PASS_CHECK=true

# Initial application setup token.
# Optional: Leave empty to generate a secure random token automatically.
# Generated token is stored in the verification table (setup_token).
# Never expose this token publicly.
SETUP_TOKEN=

# GitHub Personal Access Token.
# Optional: Required for checking private GitHub repository releases.
# Use minimum required permissions (Contents: Read-only).
# https://github.com/settings/tokens
GITHUB_TOKEN=


# ============================================================
# 3. AUTHENTICATION - BETTER AUTH
# ============================================================

# Required: Secure random secret used for signing authentication data.
# Generate using: openssl rand -base64 32
# Documentation: https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=

# Required: Base URL of your application.
# Development: http://localhost:3000
# Production: https://your-domain.com
BETTER_AUTH_URL=http://localhost:3000

# Trusted origins allowed for authentication requests.
# Comma-separated list of trusted origins.
# Examples:
# http://localhost:3000
# https://your-domain.com
# https://app.your-domain.com,https://admin.your-domain.com
#
# Wildcards should only be used when explicitly supported and necessary.
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000


# ============================================================
# 4. DATABASE - POSTGRESQL
# ============================================================

# Required: PostgreSQL connection string.
# Format:
# postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE?schema=public
#
# Example:
# postgresql://postgres:postgres@localhost:5432/settlr
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/settlr"


# ============================================================
# 5. SOCIAL AUTHENTICATION PROVIDERS (OPTIONAL)
# ============================================================

# GOOGLE LOGIN
# Create credentials: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# DISCORD LOGIN
# Create application: https://discord.com/developers/applications
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# FACEBOOK LOGIN
# Create application: https://developers.facebook.com/apps/
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=


# ============================================================
# 6. CAPTCHA - CLOUDFLARE TURNSTILE (OPTIONAL)
# ============================================================

# Public site key used by the client-side CAPTCHA widget.
# Obtain keys: https://dash.cloudflare.com/
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Private secret key used for server-side CAPTCHA verification.
TURNSTILE_SECRET_KEY=


# ============================================================
# 7. APPLICATION UPDATE WEBHOOK (OPTIONAL)
# ============================================================

# Webhook URL triggered when an application update is requested.
# Can integrate with:
# - Dokploy
# - Coolify
# - Portainer
# - Custom CI/CD deployment endpoints
# - Other deployment automation services
#
# Example: https://your-domain.com/api/update-webhook
UPDATE_WEBHOOK_URL=


# ============================================================
# END OF CONFIGURATION
# ============================================================